# Salin file ini menjadi ".env" lalu sesuaikan.

# Database PostgreSQL (WAJIB, sesuai SRS).
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/klinik

# Kunci untuk menandatangani token login. WAJIB diganti di produksi (string acak panjang).
SECRET_KEY=ganti-dengan-string-acak-panjang

# Lama token login (jam)
TOKEN_EXPIRE_HOURS=12

# Alamat frontend Next.js yang boleh memanggil API ini (pisahkan dengan koma bila lebih dari satu).
FRONTEND_URL=http://localhost:3000
# Opsional: regex origin tambahan, mis. untuk preview Vercel:  https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Informasi klinik yang tampil di website
KLINIK_NAMA=Klinik Sehat Sentosa
KLINIK_ALAMAT=Jl. Teuku Umar No. 10, Banda Aceh
KLINIK_TELEPON=(0651) 123456
KLINIK_JAM=Senin - Sabtu, 08.00 - 20.00 WIB

# Server lokal
HOST=127.0.0.1
PORT=8000
